# Copy to .env for local runs (never commit .env).

# Option A: Vertex AI on Google Cloud (used on Cloud Run, no API key needed)
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global

# Option B: a Gemini API key from Google AI Studio instead of Vertex AI
# GEMINI_API_KEY=your-key

GEMINI_MODEL=gemini-3.8-flash
# GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite

# Run without Google Cloud, with labelled sample data
# MOCK_MODE=1

# Optional
# USE_FIRESTORE=1
# YOUTUBE_API_KEY=your-youtube-data-api-key   # adds publish date and duration
# MAX_CLAIMS=12
# MAX_WINDOW_SECONDS=1800
# VERIFY_CONCURRENCY=4
# RATE_PER_IP_HOUR=6
# RATE_GLOBAL_DAY=60
# AGENTIC_LONG_VIDEOS=1
# THINKING_LEVEL=low
